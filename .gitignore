# Rust build output
/target
**/*.rs.bk

# Release archives and checksums built by scripts/release_artifacts.py. They are
# produced in the workspace for a workflow to upload, never committed, and `cargo
# package` must not pick them up.
/dist

# AgentChecksum machine-local state.
# NOTE: .agentchecksum/baseline.json is intentionally committed — CI compares
# against the behavioral baseline recorded in the repository.
.agentchecksum/runs/
.agentchecksum/cache/

# Tooling scratch space (plan ledgers, briefs, review packages). Never committed.
.superpowers/

# Bytecode from the release helper. It is a build artifact of a script, not source.
__pycache__/
*.pyc

# A failed snapshot assertion leaves the candidate here; accepting it is a
# deliberate `cargo insta accept`, not something to commit by accident.
**/*.snap.new

# macOS
.DS_Store
